{
    "slug": "produkter",
    "title": "Bygg upp produktkatalogen",
    "intro": "Produkter är arbetsytans katalog över varor och tjänster. Du lägger upp priset en gång och hämtar sedan in raden i vilket dokument som helst, i stället för att skriva av samma siffror varje gång.",
    "audience": "Arbetsyteadministratörer",
    "prerequisites": [
        "Du är inloggad i en arbetsyta där du får hantera produkter."
    ],
    "viewport": {
        "width": 1800,
        "height": 1050
    },
    "mask": [
        "[data-guide-mask]"
    ],
    "imageDir": "../../images/guider/produkter",
    "steps": [
        {
            "name": "login",
            "action": "login"
        },
        {
            "name": "oppna-produkter",
