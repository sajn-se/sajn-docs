            "name": "vanta-sparat",
            "action": "wait",
            "ms": 2000
        },
        {
            "name": "turordning-vald",
            "action": "screenshot",
            "caption": "I turordning delar upp parterna i steg",
            "notes": "Valet sparas direkt. Informationsikonen bredvid Ordning förklarar principen: nästa part får dokumentet först när den föregående har signerat. Själva ordningen ändrar du i panelen Parter."
        },
        {
            "name": "tillbaka-parter-igen",
            "action": "click",
            "selector": "button[aria-label='Parter']",
