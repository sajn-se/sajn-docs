        {
            "name": "alla-samtidigt",
            "action": "screenshot",
            "caption": "Som standard signerar alla parter samtidigt",
            "notes": "Utan signeringsordning får alla parter dokumentet på en gång och kan signera i valfri ordning. Parterna visas grupperade efter företag, eller under Privatpersoner om de inte hör till något."
        },
        {
            "name": "oppna-installningar-igen",
            "action": "click",
            "selector": "button[aria-label='Inställningar']",
