{
    "slug": "sekventiell-signering",
    "title": "Sekventiell signering — låt parter signera i steg",
    "intro": "Signeringsordningen bestämmer om alla parter får dokumentet på en gång eller om de tas ett steg i taget. Guiden bygger upp ett utkast med fyra parter och ställer om ordningen.",
    "audience": "Alla användare",
    "prerequisites": [
        "Du är inloggad i en arbetsyta där du får skapa dokument.",
        "Dokumentet är fortfarande ett utkast — signeringsordningen sätts innan du skickar."
    ],
    "viewport": {
        "width": 1800,
        "height": 1050
    },
    "mask": [
        "[data-guide-mask]"
    ],
    "hide": [
        "[data-radix-popper-content-wrapper]:has([role='tooltip'])"
    ],
    "imageDir": "../../images/guider/sekventiell-signering",
