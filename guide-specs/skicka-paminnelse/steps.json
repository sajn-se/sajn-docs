        {
            "name": "vanta-parter",
            "action": "waitForSelector",
            "selector": "button[aria-label='Partåtgärder']"
        },
        {
            "name": "dokumentet",
            "action": "screenshot",
            "caption": "Öppna dokumentet och panelen Parter",
            "notes": "Panelen Parter är förvald när du öppnar ett dokument. Varje part visas med sin e-postadress, sin roll och sin signeringsstatus. Dokumentet står i status Väntande, vilket är förutsättningen för att kunna påminna."
        },
        {
            "name": "oppna-menyn",
            "action": "click",
            "selector": "button[aria-label='Partåtgärder']",
            "match": "first",
            "caption": "Öppna partens meny och välj Skicka påminnelse",
            "notes": "Menyn öppnas med de tre prickarna till höger på raden. Den visas när du för muspekaren över raden — på pekskärm syns den alltid. Här finns också Kopiera signeringslänk, om du hellre vill skicka länken via en annan kanal."
        },
        {
            "name": "skicka-paminnelse",
            "action": "click",
            "selector": "[data-radix-popper-content-wrapper] [role='menuitem']:has-text('Skicka påminnelse')",
            "screenshot": false
        },
        {
            "name": "vanta-skickad",
            "action": "wait",
            "ms": 5000
        },
        {
            "name": "detaljer",
            "action": "click",
            "selector": "button[aria-label='Detaljer']",
            "caption": "Påminnelsen loggas i dokumentets historik",
            "notes": "Påminnelsen skickas direkt, utan bekräftelse. I panelen Detaljer ser du den i dokumentets händelselogg tillsammans med allt annat som hänt. Övriga parter påverkas inte och utgångsdatumet ändras inte."
        },
        {
            "name": "stadning-arkiv",
            "action": "click",
            "selector": "button:text-is('Arkiv')",
