        },
        {
            "name": "vanta-aterstalld",
            "action": "waitForSelector",
            "selector": "tr:has-text('Batch D: hyresavtal höst')",
            "state": "hidden"
        },
        {
            "name": "papperskorgen-utan",
            "action": "screenshot",
            "caption": "Raden försvinner ur papperskorgen"
        },
        {
            "name": "tillbaka-i-listan",
            "action": "goto",
            "url": "/{workspace}/documents",
            "caption": "Dokumentet är tillbaka i listan"
        },
        {
            "name": "stadning-markera",
            "action": "click",
